# Keep repository text deterministic across Windows, Linux, and macOS.
* text=auto eol=lf

# Native Windows command files conventionally require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.wasm binary
*.dll binary
*.exe binary

# Internal/private development records must never enter a public source archive.
.learnings/ export-ignore
.local/ export-ignore
docs/progress/ export-ignore
