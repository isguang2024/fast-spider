# Fast Spider local development environment example.
# Copy to .env only for local shell usage. Never commit .env.

# Required for first Hub startup or forced admin password rotation.
FAST_SPIDER_ADMIN_PASSWORD=

# Optional Hub command flags are normally passed directly to cmd/hub.
# Example safe local command:
# go run ./cmd/hub --listen 127.0.0.1:8787 --data-dir ./data --allowed-hosts localhost,127.0.0.1

# Optional local AI runtime overrides.
FAST_SPIDER_CODEX_EXECUTABLE=
FAST_SPIDER_CODEX_APP_SERVER_SOCKET=

# Optional test/runtime selectors used by local gates.
FAST_SPIDER_WSL_DISTRIBUTION=
FAST_SPIDER_WSL_TEST_CWD=
